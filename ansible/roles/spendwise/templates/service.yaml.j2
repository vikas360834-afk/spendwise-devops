apiVersion: v1
kind: Service
metadata:
  name: {{ app_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ app_name }}
    app.kubernetes.io/component: web
    app.kubernetes.io/part-of: spendwise-ai
    app.kubernetes.io/managed-by: ansible
spec:
  type: ClusterIP
  selector:
    app: {{ app_name }}
    tier: web
  ports:
    - name: http
      port: {{ service_port }}
      targetPort: http
      protocol: TCP
