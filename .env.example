# ==============================================================================
# SpendWise AI — Environment Configuration Template
# Copy to .env for local/containerized deployments. NEVER commit secrets.
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_64_character_string

# Persistence
DATA_DIR=/app/backend/data

# MySQL Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=spendwise_db
DB_USER=spendwise_user
DB_PASSWORD=spendwise_secure_pass_2026
MYSQL_ROOT_PASSWORD=spendwise_root_pass_2026

# AI Financial Intelligence Copilot (Optional)
# If AI_API_KEY is omitted, SpendWise seamlessly activates the offline deterministic
# math engine which computes 100% verified answers strictly from your stored ledger.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Frontend Build (Vite)
# Leave empty for same-origin proxy in Docker / local dev. Set if API is on a separate domain.
VITE_API_URL=
