{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Frontend Dev Server",
      "type": "shell",
      "command": "npm --prefix frontend run dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "npm --prefix backend run dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "Build Frontend (Production)",
      "type": "shell",
      "command": "npm --prefix frontend run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Test Suite",
      "type": "shell",
      "command": "npm --prefix backend test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker Compose: Start App & MySQL",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    },
    {
      "label": "Docker Compose: Stop All",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
